# Contact form delivery (https://resend.com). Add these in Vercel > Project > Settings > Environment Variables.
# Without RESEND_API_KEY the form tells visitors to use email or WhatsApp instead.
RESEND_API_KEY=
# Address messages are delivered to.
CONTACT_TO=info@sautihealth.com
# Verified sender on your Resend domain, e.g. "Sauti website <website@sautihealth.com>".
CONTACT_FROM=
