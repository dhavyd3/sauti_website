# Contact form delivery through Zoho Mail (app/api/contact/route.ts).
# On the live site these are set in Netlify: Project configuration →
# Environment variables. For npm run dev, copy this file to .env.local.
# Without SMTP_USER and SMTP_PASS the form asks visitors to email or WhatsApp.

# The Zoho mailbox that sends the email (full address).
SMTP_USER=hillary@sautihealth.com
# An application-specific password for that mailbox, made in Zoho:
# accounts.zoho.eu → Security → App passwords. Never commit the real one.
SMTP_PASS=

# Optional. Where messages are delivered; defaults to SMTP_USER.
CONTACT_TO=hillary@sautihealth.com
# Optional. Sender name shown in the inbox.
# CONTACT_FROM_NAME=Sauti Health website
# Optional. Send from an alias of the mailbox instead (it must be added as an
# alias in Zoho first), e.g. website@sautihealth.com.
# CONTACT_FROM=

# Optional. Zoho's server for company addresses in the EU data centre.
# SMTP_HOST=smtppro.zoho.eu
# SMTP_PORT=465
